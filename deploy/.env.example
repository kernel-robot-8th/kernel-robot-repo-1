# deploy/.env로 복사해서 쓴다. .env는 커밋하지 않는다(.gitignore).
# 이 PC가 팀 Wi-Fi에서 받은 LAN IP. 실제 값은 저장소에 적지 않는다. 확인: ip -4 addr
LAN_IP=REPLACE_ME
# 접속을 허용할 팀 Wi-Fi 대역(쉼표 구분, firewall-rules.sh가 사용). TEAM1·TEAM1_5g 각각의 CIDR.
ALLOWED_CIDRS=REPLACE_ME
# 필요할 때만 포트를 바꾼다.
#CONTROL_PORT=8000
#AI_PORT=8001
#SERVICE_PORT=8080
#WEB_SERVICE_PORT=8090
#WEB_ADMIN_PORT=8091

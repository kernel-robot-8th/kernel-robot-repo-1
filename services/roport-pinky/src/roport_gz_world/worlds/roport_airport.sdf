        <visual name="outer_window_visual"><pose>0.6986 0.1914 0.1200 0 0 3.1433</pose><geometry><box><size>4.4500 0.0050 0.2400</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <collision name="outer_window_collision"><pose>0.6986 0.1914 0.1200 0 0 3.1433</pose><geometry><box><size>4.4500 0.0050 0.2400</size></box></geometry></collision>
        <visual name="outer_left_visual"><pose>-1.5219 -0.9175 0.1200 0 0 -1.5691</pose><geometry><box><size>2.2150 0.0050 0.2400</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>

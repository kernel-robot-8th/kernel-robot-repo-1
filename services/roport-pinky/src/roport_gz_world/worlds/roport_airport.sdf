        <collision name="box_67x21_5_collision"><pose>2.0644 -0.5287 0.0750 0 0 0.0017</pose><geometry><box><size>0.6700 0.2150 0.1500</size></box></geometry></collision>
        <visual name="camera_base_visual"><pose>0.6583 -1.0257 0.0750 0 0 0.0017</pose><geometry><box><size>0.3200 0.1500 0.1500</size></box></geometry><material><ambient>0.85 0.84 0.78 1</ambient><diffuse>0.85 0.84 0.78 1</diffuse></material></visual>
        <collision name="camera_base_collision"><pose>0.6583 -1.0257 0.0750 0 0 0.0017</pose><geometry><box><size>0.3200 0.1500 0.1500</size></box></geometry></collision>
        <visual name="shelf_table_visual"><pose>0.7249 -1.9811 0.0750 0 0 0.0017</pose><geometry><box><size>0.6500 0.0750 0.1500</size></box></geometry><material><ambient>0.85 0.84 0.78 1</ambient><diffuse>0.85 0.84 0.78 1</diffuse></material></visual>
        <collision name="shelf_table_collision"><pose>0.7249 -1.9811 0.0750 0 0 0.0017</pose><geometry><box><size>0.6500 0.0750 0.1500</size></box></geometry></collision>
        <visual name="omx3_base_visual"><pose>-0.8544 -1.7938 0.0400 0 0 0.0017</pose><geometry><box><size>0.4680 0.4550 0.0800</size></box></geometry><material><ambient>0.85 0.84 0.78 1</ambient><diffuse>0.85 0.84 0.78 1</diffuse></material></visual>
        <collision name="omx3_base_collision"><pose>-0.8544 -1.7938 0.0400 0 0 0.0017</pose><geometry><box><size>0.4680 0.4550 0.0800</size></box></geometry></collision>
      </link>
    </model>
    <!-- 바닥 라인 폭 2.0 cm, 시각용(충돌 없음) -->
    <model name="floor_lines">
      <static>true</static>
      <link name="floor_lines_link">
        <visual name="warehouse_loop_0_visual"><pose>-0.8518 -1.2933 0.0005 0 0 0.0017</pose><geometry><box><size>0.9550 0.0200 0.0010</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="warehouse_loop_1_visual"><pose>-0.3851 -0.8400 0.0005 0 0 1.5725</pose><geometry><box><size>0.9250 0.0200 0.0010</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="warehouse_loop_2_visual"><pose>-0.8534 -0.3883 0.0005 0 0 3.1433</pose><geometry><box><size>0.9550 0.0200 0.0010</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="warehouse_loop_3_visual"><pose>-1.3201 -0.8416 0.0005 0 0 -1.5691</pose><geometry><box><size>0.9250 0.0200 0.0010</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="main_line_0_visual"><pose>0.9407 -1.2902 0.0005 0 0 0.0017</pose><geometry><box><size>2.6700 0.0200 0.0010</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>

<?xml version="1.0" ?>
<!-- 자동 생성 파일: 직접 고치지 말고 layout/roport_airport.yaml 을 고친 뒤
     python3 -m roport_gz_world.generate_world 로 다시 만든다. -->
<sdf version="1.8">
  <world name="roport_airport">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 2 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0 0 -1</direction>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="ground_visual"><pose>0.6931 -0.9186 0 0 0 0.0017</pose><geometry><plane><normal>0 0 1</normal><size>6 4</size></plane></geometry><material><ambient>0.42 0.42 0.43 1</ambient><diffuse>0.42 0.42 0.43 1</diffuse></material></visual>
      </link>
    </model>
    <!-- 가벽 두께 0.5 cm, 충돌 있음 -->
    <model name="walls">
      <static>true</static>
      <link name="walls_link">
        <visual name="outer_aisle_visual"><pose>0.7025 -2.0186 0.1200 0 0 0.0017</pose><geometry><box><size>4.4500 0.0050 0.2400</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <collision name="outer_aisle_collision"><pose>0.7025 -2.0186 0.1200 0 0 0.0017</pose><geometry><box><size>4.4500 0.0050 0.2400</size></box></geometry></collision>
        <visual name="outer_right_visual"><pose>2.9231 -0.9097 0.1200 0 0 1.5725</pose><geometry><box><size>2.2150 0.0050 0.2400</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
